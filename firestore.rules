rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all rule that blocks everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow read and write to the settings collection for global configuration
    match /settings/{document} {
      allow read, write: if true;
    }

    // Allow read/write to the settings_secure collection for PIN hash checks and updates
    match /settings_secure/{document} {
      allow read, write: if true;
    }

    // Allow read/write to tables
    match /tables/{document} {
      allow read, write: if true;
    }

    // Allow read/write to bookings
    match /bookings/{document} {
      allow read, write: if true;
    }

    // Allow read/write to customers
    match /customers/{document} {
      allow read, write: if true;
    }

    // Allow read/write to slot occupancy records
    match /slot_occupancy/{document} {
      allow read, write: if true;
    }
  }
}
